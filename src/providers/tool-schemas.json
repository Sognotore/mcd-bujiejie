  {
    "name": "query-nearby-stores",
    "inputSchema": {
      "type": "object",
      "properties": {
        "beType": {
          "description": "beType必传，1：到店自提, 5-得来速车道取餐(Drive Through)",
          "enum": [
            1,
            5
          ],
          "type": "integer"
        },
        "city": {
          "description": "城市名",
          "type": "string"
        },
        "keyword": {
          "description": "关键词",
          "type": "string"
        },
        "searchType": {
          "default": 1,
          "description": "searchType=2 按位置进行搜索， searchType=1 搜索收藏餐厅，默认searchType=1",
          "enum": [
            1,
            2
          ],
          "type": "integer"
        }
      },
      "required": [
        "beType",
        "searchType"
      ]
    }
  },
