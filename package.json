{
  "name": "mcd-bujiejie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "预算可选的随机一人餐搭配网页与 Skill",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "mcp:inspect": "node --env-file-if-exists=.env scripts/inspect-mcp.mjs",
    "skill:sync": "node scripts/sync-skill.mjs",
    "check": "npm test && npm run test:ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
